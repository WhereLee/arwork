# DeepSeek API Key。填了才会启用 AI 自动派单；留空则所有工单都走人工派单。
DEEPSEEK_API_KEY=

# 接口地址（OpenAI 兼容格式）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 模型名。当前官方在用的是 deepseek-flash（背后是 DeepSeek-V4.1-Flash-1017）
DEEPSEEK_MODEL=deepseek-flash

# 置信度低于这个值就转人工派单
AI_CONFIDENCE_THRESHOLD=0.7

# 单次调用超时（秒），超时直接降级
AI_TIMEOUT_SECONDS=15
